{
  "name": "@repo/api",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint src test --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prisma:generate": "echo \"Prisma placeholder: pnpm --filter @repo/api add prisma @prisma/client\"",
    "prisma:migrate:dev": "echo \"Prisma placeholder: pnpm --filter @repo/api add prisma @prisma/client\"",
    "prisma:studio": "echo \"Prisma placeholder: pnpm --filter @repo/api add prisma @prisma/client\""
  },
  "dependencies": {
    "@repo/security": "workspace:*",
    "@repo/shared": "workspace:*",
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "cors": "^2.8.5",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "tsx": "^4.19.0",
    "vitest": "^2.0.0"
  }
}
