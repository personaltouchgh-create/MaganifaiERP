{
  "name": "@repo/api",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint src test --max-warnings=0 --ignore-pattern src/generated/**",
    "typecheck": "node scripts/prisma-run.mjs generate && tsc -p tsconfig.json --noEmit",
    "test": "node scripts/prisma-run.mjs generate && vitest run",
    "prisma:generate": "node scripts/prisma-run.mjs generate",
    "prisma:migrate:dev": "node scripts/prisma-run.mjs migrate dev",
    "prisma:studio": "node scripts/prisma-run.mjs studio"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@prisma/client": "^7.8.0",
    "@repo/security": "workspace:*",
    "@repo/shared": "workspace:*",
    "cors": "^2.8.5",
    "prisma": "^7.8.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@prisma/studio-core": "0.27.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^25.7.0",
    "tsx": "^4.19.0",
    "vitest": "^2.0.0"
  }
}
